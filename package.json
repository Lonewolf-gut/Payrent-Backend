{
  "name": "rentvest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "copy-prisma-client": "node scripts/copy-prisma-client.js",
    "dev": "node scripts/start-dev.js",
    "dev:turbo": "node scripts/start-dev.js --turbo",
    "dev:webpack": "node scripts/start-dev.js --webpack",
    "dev:clean-turbo": "node scripts/prune-turbopack-cache.js",
    "clean": "node scripts/clean-cache.js",
    "dev:reset": "node scripts/stop-dev.js && node scripts/remove-dev-cache-link.js && node scripts/clean-cache.js && node scripts/fix-swc-win.js",
    "dev:fix": "npm run dev:reset",
    "fix:swc": "node scripts/fix-swc-win.js",
    "ensure:split-repo": "node scripts/ensure-split-repo-files.js",
    "ensure:backend-only": "node scripts/ensure-backend-api-only.js",
    "prebuild": "node scripts/ensure-backend-api-only.js && node scripts/ensure-split-repo-files.js",
    "predev": "node scripts/ensure-backend-api-only.js && node scripts/ensure-split-repo-files.js",
    "build": "npm run db:generate && npm run copy-prisma-client && next build --webpack",
    "build:win": "node scripts/build-win.js",
    "start": "node scripts/start-prod.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma-generate.js",
    "db:push": "prisma db push",
    "db:sync-docker": "node scripts/db-sync-docker.js",
    "db:role-rebrand": "node scripts/db-role-rebrand.js",
    "db:migrate-roles": "node scripts/db-migrate-roles.js",
    "db:compliance-models": "node scripts/db-compliance-models.js",
    "db:business-rules": "node scripts/db-business-rules.js",
    "db:payout-banks": "node scripts/db-payout-banks.js",
    "db:bank-partner": "node scripts/db-bank-partner.js",
    "docs:bank-partner-pdf": "node scripts/generate-bank-partner-api-pdf.js",
    "docs:integrations-pdf": "node scripts/generate-integration-docs-pdf.js",
    "docs:kyb-matrix-pdf": "node scripts/generate-kyb-matrix-pdf.js",
    "db:financing-workflow": "node scripts/db-financing-workflow.js",
    "db:user-last-login": "node scripts/db-user-last-login.js",
    "db:ssnit-theme": "node scripts/db-ssnit-theme.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:demo-listings": "npx tsx scripts/seed-demo-listings.ts",
    "db:studio": "prisma studio",
    "docker:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-up.ps1",
    "docker:down": "docker compose down",
    "docker:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-docker.ps1",
    "bring-up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bring-up.ps1"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.14",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "otpauth": "^9.5.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.0",
    "resend": "^4.8.0",
    "shadcn": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "16.2.6",
    "@next/swc-wasm-nodejs": "16.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^28.1.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
