# =============================================================================
# PayForMe / PayRent — local development environment
# Copy to .env and replace placeholder secrets. Never commit .env to git.
# =============================================================================

# --- Core ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SHOW_DEV_OTP="true"

# --- Database ---
DATABASE_URL="postgresql://rentvest:rentvest@localhost:5432/rentvest?schema=public&connect_timeout=60&pool_timeout=60"

# --- Redis (sessions, rate limits, pending payments) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (NextAuth / Auth.js) ---
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# --- JWT (API / mobile Bearer tokens — separate from browser session) ---
JWT_ACCESS_SECRET="replace-with-min-32-char-secret"
JWT_REFRESH_SECRET="replace-with-min-32-char-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# --- Encryption (must be exactly 64 hex chars for AES-256) ---
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- Cron jobs (production scheduled tasks) ---
# Generate: openssl rand -base64 32
CRON_SECRET="replace-with-openssl-rand-base64-32"

# --- Email ---
# Development: Resend API (recommended)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="PayForMe <onboarding@resend.dev>"
# Production: SMTP (set EMAIL_PROVIDER=smtp in production)
EMAIL_PROVIDER="resend"
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="PayForMe <noreply@yourdomain.com>"
# SMTP_MODE="log"

# --- SMS ---
# Providers: log (dev), arkesel (recommended for Ghana), hubtel, twilio
# Ready-to-copy Arkesel block (with your dashboard API): docs/arkesel-copy-to-env.txt
# Or run: powershell -File scripts/apply-arkesel-env.ps1
SMS_PROVIDER="arkesel"

# Arkesel — from https://sms.arkesel.com dashboard
SMS_API_KEY="your_arkesel_api_key"
ARKESEL_SMS_SENDER_ID="PayForMe"
ARKESEL_SMS_API_VERSION="legacy"
SMS_API_URL="https://sms.arkesel.com/sms/api"

# Hubtel SMS (alternative)
# HUBTEL_SMS_CLIENT_ID=""
# HUBTEL_SMS_CLIENT_SECRET=""
# HUBTEL_SMS_SENDER_ID=""

# Twilio (international)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# =============================================================================
# PAYMENTS
# =============================================================================
# Provider for wallet deposits + subscriptions:
#   momo     = MTN MoMo (production)
#   log      = sandbox messages only (good for local dev without MoMo keys)
#   paystack = legacy (not used for collections in current build)
#   hubtel   = legacy
PAYMENT_PROVIDER="log"

# --- MoMo (wallet deposits + subscription payments) ---
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_API_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_CURRENCY="EUR"
MOMO_CALLBACK_URL="http://localhost:3000/api/webhooks/payments/momo"

# --- Paystack (bank account lookup / resolve only — not payment collection) ---
PAYSTACK_SECRET_KEY="sk_test_your_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_key"
# Webhook secret from Paystack dashboard (NOT a URL). Leave empty if lookup-only.
PAYSTACK_WEBHOOK_SECRET=""

# --- Partner Bank API (banks call your API to credit/debit user wallets) ---
# Header: x-bank-api-key: <BANK_API_KEY>
BANK_API_KEY="replace-with-partner-bank-api-secret"
BANK_API_URL=""
# Optional HMAC secret for POST /api/webhooks/bank (defaults to BANK_API_KEY)
BANK_WEBHOOK_SECRET=""

# --- Platform fees (percentages) ---
SERVICE_FEE_PERCENT="1.5"
COMMISSION_FEE_PERCENT="2.0"
PROCESSING_FEE_PERCENT="0.5"
AGENT_COMMISSION_PERCENT="2.5"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# --- Dev bundler (optional) ---
# DEV_BUNDLER="turbopack"
# DEV_BUNDLER="webpack"
